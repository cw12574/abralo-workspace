{
  "name": "agent-workspace",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "tsx watch apps/service/src/main.ts",
    "web": "vite --config apps/web/vite.config.ts --configLoader native",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts --configLoader native && tsc -p tsconfig.service.json",
    "start": "node dist/service/apps/service/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2 --testTimeout 15000",
    "test:live": "tsx scripts/live-smoke.ts",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "10.1.2",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@openai/codex": "0.156.1",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "google-auth-library": "11.1.0",
    "opencode-ai": "1.18.32",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@opencode-ai/sdk": "1.18.32",
    "@playwright/test": "1.63.0",
    "@tanstack/react-virtual": "3.14.13",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "lucide-react": "0.577.0",
    "pdfjs-dist": "6.3.289",
    "prettier": "3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "opencode-ai"
    ]
  },
  "files": [
    "dist",
    "scripts/launcher.mjs",
    "scripts/installed-launcher.mjs",
    "scripts/maintenance-helper.mjs",
    "scripts/stage-update.mjs",
    "scripts/install-windows.ps1",
    "README.md",
    "docs/preview",
    "scripts/restore.mjs",
    "scripts/install-posix.mjs",
    "LICENSE"
  ]
}
